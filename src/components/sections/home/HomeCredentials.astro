---
/**
 * 08 — CREDENTIALS
 *
 * Presents only what is confirmed. Because no credentials were supplied with
 * the source material, this section currently states that registrations are
 * being confirmed rather than implying any registration Spartcon may not hold.
 *
 * As soon as a credential in credentials.ts is marked `verified`, it appears
 * here automatically and the notice adjusts.
 */
import Section from "@components/ui/Section.astro";
import Button from "@components/ui/Button.astro";
import EditorialNote from "@components/ui/EditorialNote.astro";
import { verifiedCredentials, pendingCredentials } from "@data/credentials";
---

<Section id="credentials" aria-labelledby="creds-title">
  <div class="creds">
    <header class="creds__head">
      <p class="eyebrow">
        <span class="index-num">08</span>
        <span>Credentials</span>
      </p>
      <h2 id="creds-title" class="t-h1 creds__title" data-reveal>
        Registrations and compliance.
      </h2>
      <p class="t-body creds__lead" data-reveal style="--reveal-delay:100ms">
        Construction procurement in South Africa turns on verifiable
        registration. We publish credentials only once they are confirmed.
      </p>
      <div class="creds__cta" data-reveal style="--reveal-delay:160ms">
        <Button href="/credentials" variant="ghost" arrow>
          Credentials detail
        </Button>
      </div>
    </header>

    <div class="creds__body">
      {
        verifiedCredentials.length > 0 && (
          <ul class="creds__list" role="list" data-reveal-group="70">
            {verifiedCredentials.map((c) => (
              <li class="creds__item">
                <span class="creds__body-label">{c.body}</span>
                <span class="creds__item-title">{c.title}</span>
                {c.grade && <span class="creds__grade">{c.grade}</span>}
                {c.registrationNumber && (
                  <span class="creds__reg">{c.registrationNumber}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        verifiedCredentials.length === 0 && (
          <EditorialNote title="Credentials are being confirmed">
            <p>
              No registration details were supplied for this build, so none are
              shown. Rather than display an unconfirmed registration, the
              following credentials are listed as pending. Each will be published
              here once Spartcon provides the verified detail.
            </p>
            <ul>
              {pendingCredentials.map((c) => (
                <li>
                  <strong>{c.body}</strong> — {c.title}
                </li>
              ))}
            </ul>
          </EditorialNote>
        )
      }
    </div>
  </div>
</Section>

<style>
  .creds {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }

  .creds__title {
    max-width: 16ch;
  }

  .creds__lead {
    margin-top: var(--s-4);
    max-width: 44ch;
  }

  .creds__cta {
    margin-top: var(--s-5);
  }

  .creds__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .creds__item {
    background: var(--bg);
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .creds__body-label {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
    color: var(--accent-text);
  }

  .creds__item-title {
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .creds__grade,
  .creds__reg {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--fg-subtle);
  }

  @media (max-width: 900px) {
    .creds {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
