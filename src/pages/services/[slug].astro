---
/**
 * SERVICE DETAIL — one page per service line, generated from services.ts.
 * Adding a service to the data file creates its page automatically.
 */
import type { GetStaticPaths } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/ui/PageHero.astro";
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import MediaFrame from "@components/ui/MediaFrame.astro";
import Button from "@components/ui/Button.astro";
import Accordion from "@components/ui/Accordion.astro";
import ContactCta from "@components/sections/ContactCta.astro";
import { services } from "@data/services";
import { industries } from "@data/industries";

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;

/** Other service lines, for cross-navigation at the foot of the page. */
const others = services.filter((s) => s.slug !== service.slug);

/** Sectors this service line serves. */
const relevantIndustries = industries.filter((i) =>
  i.served.includes("Construction")
);

const accordionItems = service.capabilities.map((cap, i) => ({
  id: `cap-${i}`,
  index: String(i + 1).padStart(2, "0"),
  title: cap.title,
  summary: cap.summary,
  points: cap.items,
}));
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={service.slug}
  ogType="article"
>
  <PageHero
    eyebrow="Services"
    title={service.title}
    lead={service.intro}
    image={service.image}
    breadcrumbs={[{ label: "Services", href: "/services" }]}
    facts={[
      { label: "Service line", value: service.index },
      { label: "Focus", value: service.strapline },
      { label: "Capabilities", value: String(service.capabilities.length) },
    ]}
  />

  <!-- ================================================================= intro -->
  <Section aria-labelledby="svc-intro-title">
    <div class="split">
      <div>
        <SectionHeader
          index="01"
          eyebrow="Overview"
          title={service.strapline}
          id="svc-intro-title"
        />
      </div>

      <div class="prose" data-reveal>
        {service.body.map((para) => <p>{para}</p>)}

        <div class="intro__cta">
          <Button href="/contact" variant="secondary" arrow>
            Discuss a {service.title.toLowerCase()} project
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <!-- ========================================================== capabilities -->
  <Section surface="muted" aria-labelledby="svc-caps-title">
    <SectionHeader
      index="02"
      eyebrow="Capabilities"
      title="What this service line covers."
      lead="Expand each capability for the specific scope we deliver."
      layout="split"
      id="svc-caps-title"
    />

    <div class="caps">
      <Accordion items={accordionItems} defaultOpen={0} />

      {
        service.bodyImage && (
          <div class="caps__media">
            <MediaFrame
              slug={service.bodyImage}
              ratio="3/4"
              sizes="(max-width: 1024px) 100vw, 32vw"
              parallax
            />
          </div>
        )
      }
    </div>
  </Section>

  <!-- ============================================================== sectors -->
  <Section aria-labelledby="svc-sectors-title">
    <SectionHeader
      index="03"
      eyebrow="Sectors"
      title="Where this work is delivered."
      lead="Our experience in multidisciplinary projects spans mining, residential, factories, corporate offices and warehouse spaces, as well as government and commercial infrastructure."
      layout="split"
      id="svc-sectors-title"
    />

    <ul class="sectors" role="list" data-reveal-group="50">
      {
        relevantIndustries.map((ind) => (
          <li>
            <a href={`/industries#${ind.slug}`} class="sectors__link">
              <span class="sectors__index">{ind.index}</span>
              <span class="sectors__label">{ind.shortTitle ?? ind.title}</span>
              <span class="sectors__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="13" height="13">
                  <path
                    d="M1 8h13M9 3l5 5-5 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="square"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ====================================================== other services -->
  <Section surface="inset" spacing="tight" aria-labelledby="svc-other-title">
    <h2 id="svc-other-title" class="t-h3 other__title">Other service lines</h2>

    <div class="other" data-reveal-group="80">
      {
        others.map((s) => (
          <a href={`/services/${s.slug}`} class="other__card">
            <span class="other__index">{s.index}</span>
            <span class="other__name">{s.title}</span>
            <span class="other__strap">{s.strapline}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <ContactCta
    title="Let's build what comes next."
    lead={`Talk to us about ${service.title.toLowerCase()} on your next project.`}
    secondaryLabel="All Services"
    secondaryHref="/services"
  />
</BaseLayout>

<style>
  .intro__cta {
    margin-top: var(--s-7);
  }

  /* ------------------------------------------------------------ capabilities */

  .caps {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(2rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }

  .caps__media {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }

  /* ---------------------------------------------------------------- sectors */

  .sectors {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .sectors__link {
    background: var(--bg);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-5);
    height: 100%;
    transition: background-color var(--d-fast) var(--e-out);
  }

  .sectors__link:hover {
    background: var(--bg-muted);
  }

  .sectors__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .sectors__label {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
  }

  .sectors__arrow {
    color: var(--fg-subtle);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--d-mid) var(--e-out),
      transform var(--d-mid) var(--e-out);
  }

  .sectors__link:hover .sectors__arrow,
  .sectors__link:focus-visible .sectors__arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent-text);
  }

  /* --------------------------------------------------------- other services */

  .other__title {
    margin-bottom: var(--s-5);
  }

  .other {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-4);
  }

  .other__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--s-5);
    background: var(--bg);
    border: 1px solid var(--line);
    position: relative;
    transition: border-color var(--d-fast) var(--e-out);
  }

  .other__card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-mid) var(--e-out);
  }

  .other__card:hover {
    border-color: var(--line-strong);
  }

  .other__card:hover::before {
    transform: scaleX(1);
  }

  .other__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--accent-text);
  }

  .other__name {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 600;
    letter-spacing: var(--tr-snug);
  }

  .other__strap {
    font-size: var(--t-xs);
    color: var(--fg-subtle);
  }

  /* ------------------------------------------------------------ breakpoints */

  @media (max-width: 1024px) {
    .caps {
      grid-template-columns: minmax(0, 1fr);
    }

    .caps__media {
      position: static;
      max-width: 24rem;
    }
  }
</style>
