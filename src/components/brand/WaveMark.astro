---
/**
 * The Spartcon wave mark — two orange wave ribbons.
 *
 * Redrawn from the official artwork supplied in the Spartcon.logo repository
 * (reversed lockup on navy). Measured from that artwork:
 *   - mark width  ≈ 0.91 × wordmark width
 *   - mark height ≈ 1.34 × wordmark cap height
 *   - overall aspect ratio ≈ 3.5 : 1
 *   - each ribbon is roughly 1.9 : 1 within the mark
 *
 * Shape logic: each ribbon is a band that starts high at its left cut and
 * sweeps DOWN to the right, with an S-curve along both edges. Because the
 * second ribbon restarts high, the pair reads as a stepped double wave — the
 * notch in the middle of the official mark.
 *
 * NOTE FOR THE CLIENT: this is a faithful vector reconstruction, not the
 * original artwork. Replace with Spartcon's official SVG before launch to
 * guarantee exact brand geometry.
 */
interface Props {
  /**
   * Height in CSS units; width follows the aspect ratio.
   *
   * Left undefined by default ON PURPOSE. An inline `height` would beat any
   * class-based rule on specificity, which previously stopped <Logo> from
   * sizing the mark at all. When omitted, sizing is left to CSS.
   */
  height?: string;
  color?: string;
  class?: string;
}

const { height, color = "var(--accent)", class: className } = Astro.props;

const style = ["width:auto", "flex:none", height ? `height:${height}` : null]
  .filter(Boolean)
  .join(";");

/**
 * One ribbon: 62 wide, ~31 tall, band thickness 15.
 *
 * The band is deliberately THICKER (15) than the vertical travel of its top
 * edge (10). That is what makes the official mark read as a bold ribbon rather
 * than a thin diagonal stripe — the edges stay close to parallel while the
 * whole band undulates.
 */
const ribbon = [
  "M0 6",
  "C14 1 24 4 36 10",
  "C46 15 54 17 62 16",
  "L62 31",
  "C54 32 46 30 36 25",
  "C24 19 14 16 0 21",
  "Z",
].join(" ");
---

<svg
  class={className}
  viewBox="0 0 134 37"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  style={style}
>
  <!-- Left ribbon, dropped so the pair sits balanced in the box -->
  <path fill={color} d={ribbon} transform="translate(0 5)" />
  <!-- Right ribbon restarts high, creating the stepped notch in the middle -->
  <path fill={color} d={ribbon} transform="translate(72 0)" />
</svg>
