---
/**
 * ACCORDION — progressive-disclosure list built on <details>/<summary>.
 *
 * Native elements are used deliberately: keyboard support, focus handling and
 * the open/closed state all come for free and work without JavaScript. A small
 * enhancement script animates the height; the component is fully usable if it
 * never runs.
 */
export type AccordionItem = {
  id?: string;
  title: string;
  /** Mono label on the left, e.g. an index or category. */
  index?: string;
  summary?: string;
  /** Bullet points revealed when open. */
  points?: string[];
  /** Longer body copy revealed when open. */
  body?: string;
};

interface Props {
  items: AccordionItem[];
  /** Index of the item open on load, or null for all closed. */
  defaultOpen?: number | null;
  /** Only one panel open at a time. */
  exclusive?: boolean;
  class?: string;
}

const {
  items,
  defaultOpen = 0,
  exclusive = false,
  class: className,
} = Astro.props;

const groupName = exclusive
  ? `acc-${Math.random().toString(36).slice(2, 8)}`
  : undefined;
---

<div class:list={["acc", className]} data-accordion>
  {
    items.map((item, i) => (
      <details
        class="acc__item"
        name={groupName}
        open={defaultOpen === i}
        data-reveal="fade"
        style={`--reveal-delay:${Math.min(i * 60, 300)}ms`}
      >
        <summary class="acc__summary">
          {item.index && <span class="acc__index">{item.index}</span>}
          <span class="acc__heading">
            <span class="acc__title">{item.title}</span>
            {item.summary && <span class="acc__sub">{item.summary}</span>}
          </span>
          <span class="acc__icon" aria-hidden="true">
            <span class="acc__icon-h"></span>
            <span class="acc__icon-v"></span>
          </span>
        </summary>

        <div class="acc__panel">
          <div class="acc__panel-inner">
            {item.body && <p class="acc__body">{item.body}</p>}
            {item.points && item.points.length > 0 && (
              <ul class="acc__points" role="list">
                {item.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            <slot name={item.id ?? item.title} />
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .acc {
    border-top: 1px solid var(--line);
  }

  .acc__item {
    border-bottom: 1px solid var(--line);
  }

  .acc__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    align-items: center;
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem) 0;
    cursor: pointer;
    list-style: none;
    transition: color var(--d-fast) var(--e-out);
  }

  /* Hide the native disclosure triangle across engines. */
  .acc__summary::-webkit-details-marker {
    display: none;
  }
  .acc__summary::marker {
    content: "";
  }

  .acc__summary:hover .acc__title {
    color: var(--accent-text);
  }

  .acc__index {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .acc__heading {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .acc__title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    letter-spacing: var(--tr-snug);
    transition: color var(--d-fast) var(--e-out);
  }

  .acc__sub {
    font-size: var(--t-sm);
    color: var(--fg-muted);
    max-width: 62ch;
  }

  /* Plus/minus drawn from two rules — no icon font, no SVG payload. */
  .acc__icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .acc__icon-h,
  .acc__icon-v {
    position: absolute;
    background: var(--fg);
    transition: transform var(--d-mid) var(--e-out),
      opacity var(--d-mid) var(--e-out);
  }

  .acc__icon-h {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .acc__icon-v {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%) scaleY(1);
  }

  .acc__item[open] .acc__icon-v {
    transform: translateX(-50%) scaleY(0);
  }

  .acc__item[open] .acc__title {
    color: var(--accent-text);
  }

  /* Panel animation. The script sets an explicit height for the transition and
     removes it afterwards, so content reflows naturally. */
  .acc__panel {
    overflow: hidden;
  }

  .acc__panel-inner {
    padding: 0 0 clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-right: clamp(0rem, 4vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    max-width: 72ch;
  }

  .acc__body {
    font-size: var(--t-body);
    color: var(--fg-muted);
    line-height: var(--lh-body);
  }

  .acc__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .acc__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--t-sm);
    color: var(--fg-muted);
  }

  .acc__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 640px) {
    .acc__summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-4);
    }

    .acc__index {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  /**
   * Height-animates <details> panels. Purely an enhancement — the accordion is
   * fully functional without it.
   */
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-accordion]").forEach((group) => {
    group.querySelectorAll<HTMLDetailsElement>("details").forEach((details) => {
      const summary = details.querySelector<HTMLElement>("summary");
      const panel = details.querySelector<HTMLElement>(".acc__panel");
      if (!summary || !panel) return;

      let animating = false;

      const setHeight = (from: number, to: number, open: boolean) => {
        animating = true;
        panel.style.height = `${from}px`;
        requestAnimationFrame(() => {
          panel.style.transition = "height 420ms cubic-bezier(0.22,1,0.36,1)";
          panel.style.height = `${to}px`;
        });
        const done = () => {
          panel.style.transition = "";
          panel.style.height = "";
          if (!open) details.open = false;
          animating = false;
          panel.removeEventListener("transitionend", done);
        };
        panel.addEventListener("transitionend", done);
      };

      summary.addEventListener("click", (e) => {
        if (reduce.matches || animating) return;
        e.preventDefault();

        if (!details.open) {
          details.open = true;
          setHeight(0, panel.scrollHeight, true);
        } else {
          setHeight(panel.scrollHeight, 0, false);
        }
      });
    });
  });
</script>
