---
/**
 * 404 — keeps a lost visitor moving rather than dead-ending them.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/ui/Section.astro";
import Button from "@components/ui/Button.astro";
import { primaryNav } from "@data/navigation";
import { techBrand } from "@data/spartcon-tech";

const destinations = [
  { label: "Home", href: "/", desc: "Start again from the top" },
  { label: "Services", href: "/services", desc: "Construction and civil service lines" },
  { label: "Capabilities", href: "/capabilities", desc: "The full technical index" },
  {
    label: "Facilities Engineering",
    href: techBrand.basePath,
    desc: "Spartcon Tech",
  },
  { label: "Industries", href: "/industries", desc: "Sectors we serve" },
  { label: "Contact", href: "/contact", desc: "Start a conversation" },
];
---

<BaseLayout
  title="Page not found | Spartcon"
  description="The page you were looking for could not be found."
  noindex
>
  <Section class="nf" surface="navy" spacing="loose">
    <div class="nf__inner">
      <p class="eyebrow nf__eyebrow">Error 404</p>

      <h1 class="t-display nf__title">This page isn't here.</h1>

      <p class="nf__lead">
        The address may have changed, or the link that brought you here may be out
        of date. Nothing is broken on your side.
      </p>

      <div class="nf__actions">
        <Button href="/" variant="primary" size="lg" arrow>Back to home</Button>
        <Button href="/contact" variant="secondary" size="lg">
          Start a Conversation
        </Button>
      </div>

      <nav class="nf__nav" aria-label="Suggested pages">
        <h2 class="nf__nav-title">Or try one of these</h2>
        <ul role="list">
          {
            destinations.map((d, i) => (
              <li>
                <a href={d.href} class="nf__link">
                  <span class="nf__link-index">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="nf__link-body">
                    <span class="nf__link-label">{d.label}</span>
                    <span class="nf__link-desc">{d.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Section>
</BaseLayout>

<style>
  .nf {
    /* Clears the fixed nav since there is no page hero here. */
    padding-top: calc(var(--nav-h) + var(--section-y));
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .nf__inner {
    max-width: 62rem;
  }

  .nf__eyebrow {
    color: var(--accent-text);
  }

  .nf__title {
    color: var(--white);
    max-width: 18ch;
  }

  .nf__lead {
    margin-top: var(--s-5);
    font-size: var(--t-lead);
    line-height: var(--lh-relaxed);
    color: var(--navy-200);
    max-width: 52ch;
  }

  .nf__actions {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* ------------------------------------------------------------ suggestions */

  .nf__nav {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line-invert);
  }

  .nf__nav-title {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--navy-300);
    margin-bottom: var(--s-4);
  }

  .nf__nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-invert);
    border: 1px solid var(--line-invert);
  }

  .nf__link {
    display: flex;
    gap: 0.7rem;
    padding: var(--s-4);
    background: var(--navy-900);
    height: 100%;
    transition: background-color var(--d-fast) var(--e-out);
  }

  .nf__link:hover {
    background: var(--navy-700);
  }

  .nf__link-index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--accent-text);
    padding-top: 0.2rem;
  }

  .nf__link-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nf__link-label {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 600;
    letter-spacing: var(--tr-snug);
    color: var(--white);
  }

  .nf__link-desc {
    font-size: var(--t-xs);
    color: var(--navy-300);
  }

  @media (max-width: 860px) {
    .nf__nav ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .nf__nav ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .nf__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
