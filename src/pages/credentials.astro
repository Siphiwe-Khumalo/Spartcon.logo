---
/**
 * CREDENTIALS — registrations, grading, professional bodies and clients.
 *
 * Verified credentials are presented as held. Outstanding items are listed
 * separately and clearly marked as awaiting verification — never implied.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/ui/PageHero.astro";
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import EditorialNote from "@components/ui/EditorialNote.astro";
import Button from "@components/ui/Button.astro";
import ContactCta from "@components/sections/ContactCta.astro";
import {
  credentials,
  credentialCategories,
  verifiedCredentials,
  pendingCredentials,
  clients,
  clientSectors,
  jointVentures,
  anyClientLogos,
} from "@data/credentials";
import { standards } from "@data/company";
---

<BaseLayout
  title="Credentials & Registrations | Spartcon"
  description="Spartcon (Pty) Ltd is 100% BEE owned, CIDB graded 7ME, 7CE and 6GB PE, NHBRC registered, with construction and engineering managers registered with ECSA and SACPCMP."
  ogImage="credentials"
>
  <PageHero
    eyebrow="Credentials"
    title="Registrations, grading and professional standing."
    lead="Construction procurement in South Africa turns on verifiable registration. Everything presented here as held is stated in Spartcon's own company profile."
    image="municipal-administration-building"
    facts={[
      { label: "Ownership", value: "100% BEE" },
      { label: "CIDB", value: "7ME · 7CE · 6GB PE" },
      { label: "NHBRC", value: "Registered" },
      { label: "Professional", value: "ECSA · SACPCMP" },
    ]}
  />

  <!-- ==================================================== verified credentials -->
  <Section aria-labelledby="held-title">
    <SectionHeader
      index="01"
      eyebrow="Held"
      title="Our registrations."
      lead="CIDB grading determines the value and class of public-sector work a contractor may tender for. NHBRC registration is a legal requirement for residential home building."
      layout="split"
      id="held-title"
    />

    {
      credentialCategories.map((category) => {
        const list = verifiedCredentials.filter((c) => c.category === category);
        if (!list.length) return null;
        return (
          <div class="cat">
            <h3 class="cat__title">{category}</h3>
            <ul class="creds" role="list" data-reveal-group="70">
              {list.map((c) => (
                <li class="cred">
                  <div class="cred__head">
                    <span class="cred__body">{c.body}</span>
                    {c.grade && <span class="cred__grade">{c.grade}</span>}
                  </div>
                  <h4 class="cred__title">{c.title}</h4>
                  {c.bodyFullName && (
                    <p class="cred__full">{c.bodyFullName}</p>
                  )}
                  {c.detail && <p class="cred__detail">{c.detail}</p>}
                  <p class="cred__sig">{c.significance}</p>
                  {c.registrationNumber && (
                    <p class="cred__reg">Reg. {c.registrationNumber}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </Section>

  <!-- ====================================================== awaiting details -->
  {
    pendingCredentials.length > 0 && (
      <Section surface="muted" aria-labelledby="pending-title">
        <SectionHeader
          index="02"
          eyebrow="Documentation"
          title="Awaiting verified detail."
          lead="These items are commonly requested during tender and vendor onboarding. They are listed here as outstanding rather than presented as confirmed."
          layout="split"
          id="pending-title"
        />

        <EditorialNote title="Not yet published on this website">
          <p>
            The following documentation was not included in the supplied company
            profiles. Each will be published on this page once Spartcon provides
            the verified detail. Nothing below is currently being claimed.
          </p>
          <ul>
            {pendingCredentials.map((c) => (
              <li>
                <strong>{c.body} — {c.title}.</strong> {c.significance}
              </li>
            ))}
          </ul>
        </EditorialNote>

        <div class="pending__note">
          <p class="t-sm">
            Registration numbers for the credentials we do hold — CIDB, NHBRC and
            the individual ECSA and SACPCMP registrations — were also not
            supplied, so the numbers are omitted rather than invented. The
            registrations themselves are stated in Spartcon's company profile.
          </p>
        </div>
      </Section>
    )
  }

  <!-- ============================================================= standards -->
  <Section aria-labelledby="cred-standards-title">
    <SectionHeader
      index="03"
      eyebrow="Standards"
      title="Codes and standards we work to."
      layout="split"
      id="cred-standards-title"
      lead="Applied as minimum engineering standards across construction and facilities engineering, alongside OEM operational standards."
    />

    <dl class="std" data-reveal-group="50">
      {
        standards.map((s) => (
          <div class="std__row">
            <dt>{s.code}</dt>
            <dd>{s.scope}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- =============================================================== clients -->
  <Section surface="navy" aria-labelledby="cred-clients-title">
    <SectionHeader
      index="04"
      eyebrow="Clients"
      title="Organisations we have worked with."
      lead="Listed in Spartcon's company profile across mining, public sector, industrial, education, health and commercial."
      layout="split"
      id="cred-clients-title"
    />

    <div class="clients">
      {
        clientSectors.map((sector) => {
          const list = clients.filter((c) => c.sector === sector);
          if (!list.length) return null;
          return (
            <div class="clients__group" data-reveal>
              <h3 class="clients__sector">{sector}</h3>
              <ul role="list">
                {list.map((c) => <li>{c.name}</li>)}
              </ul>
            </div>
          );
        })
      }
    </div>

    {
      jointVentures.length > 0 && (
        <div class="jv">
          <h3 class="jv__title">Joint ventures</h3>
          <ul role="list">
            {jointVentures.map((jv) => <li>{jv.name}</li>)}
          </ul>
        </div>
      )
    }

    {
      !anyClientLogos && (
        <div class="clients__logos">
          <p class="clients__logos-title">Client logos</p>
          <p class="clients__logos-text">
            Client logos are not displayed on this website. Reproducing a
            third-party logo is a trademark matter that requires written
            permission from each organisation, and no logo files were supplied.
            Once permission and artwork are available for a given client, its
            logo can be added without any change to this page's structure.
          </p>
        </div>
      )
    }

    <p class="clients__note">
      Client names are reproduced from Spartcon's supplied company profile. All
      third-party names and marks remain the property of their respective owners.
      Inclusion here does not imply endorsement.
    </p>
  </Section>

  <!-- ======================================================= document request -->
  <Section surface="inset" spacing="tight">
    <div class="xl">
      <div>
        <h2 class="t-h3">Need our compliance pack for a tender?</h2>
        <p class="t-sm xl__text">
          CIDB certificates, B-BBEE affidavit, tax compliance status, COID letter
          of good standing and professional registration certificates can be
          supplied on request.
        </p>
      </div>
      <div class="xl__actions">
        <Button href="/contact" variant="primary" arrow>Request documents</Button>
      </div>
    </div>
  </Section>

  <ContactCta
    title="Let's build what comes next."
    lead="Talk to us about an appointment, a tender, or a facilities maintenance contract."
    secondaryLabel="Projects & Experience"
    secondaryHref="/projects"
  />
</BaseLayout>

<style>
  /* ------------------------------------------------------------- categories */

  .cat + .cat {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .cat__title {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: var(--s-5);
  }

  .creds {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--s-4);
  }

  .cred {
    border: 1px solid var(--line);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    transition: border-color var(--d-mid) var(--e-out);
  }

  .cred::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--accent);
  }

  .cred:hover {
    border-color: var(--line-strong);
  }

  .cred__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cred__body {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
    line-height: 1;
  }

  .cred__grade {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid currentColor;
    padding: 0.25rem 0.45rem;
  }

  .cred__title {
    font-family: var(--font-display);
    font-size: var(--t-h4);
    font-weight: 600;
    letter-spacing: var(--tr-snug);
  }

  .cred__full {
    font-size: var(--t-xs);
    color: var(--fg-subtle);
    line-height: 1.5;
  }

  .cred__detail {
    font-size: var(--t-sm);
    color: var(--fg);
    line-height: var(--lh-body);
  }

  .cred__sig {
    font-size: var(--t-xs);
    color: var(--fg-muted);
    line-height: 1.65;
    padding-top: 0.6rem;
    margin-top: auto;
    border-top: 1px solid var(--line);
  }

  .cred__reg {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--fg-subtle);
  }

  /* ---------------------------------------------------------------- pending */

  .pending__note {
    margin-top: var(--s-6);
    padding-left: var(--s-4);
    border-left: 2px solid var(--line-strong);
    max-width: 72ch;
  }

  /* -------------------------------------------------------------- standards */

  .std {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .std__row {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
    gap: var(--s-5);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
  }

  .std__row dt {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .std__row dd {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--fg-muted);
    line-height: var(--lh-body);
  }

  /* ---------------------------------------------------------------- clients */

  .clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--s-6) var(--s-5);
  }

  .clients__sector {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line-invert);
    margin-bottom: var(--s-4);
  }

  .clients__group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .clients__group li {
    font-size: var(--t-sm);
    color: var(--navy-100);
    line-height: 1.5;
  }

  .jv {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-invert);
  }

  .jv__title {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-3);
  }

  .jv ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jv li {
    font-size: var(--t-sm);
    color: var(--navy-100);
  }

  .clients__logos {
    margin-top: var(--s-6);
    padding: var(--s-5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-invert);
    max-width: 78ch;
  }

  .clients__logos-title {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .clients__logos-text {
    font-size: var(--t-sm);
    color: var(--navy-200);
    line-height: var(--lh-body);
  }

  .clients__note {
    margin-top: var(--s-6);
    font-size: var(--t-xs);
    color: var(--navy-300);
    max-width: 78ch;
    line-height: 1.7;
  }

  /* ------------------------------------------------------------ cross-links */

  .xl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }

  .xl__text {
    margin-top: var(--s-3);
    max-width: 60ch;
  }

  @media (max-width: 620px) {
    .std__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
    }
  }
</style>
