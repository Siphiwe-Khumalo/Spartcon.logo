---
/**
 * SPARTCON / SPARTCON TECH LOCKUP
 *
 * Renders the official Spartcon artwork (the wave mark + wordmark, supplied by
 * the client as a single flattened image on its native navy ground) plus, for
 * the "tech" variant, a tracked "TECHNOLOGIES" subline that identifies the
 * Facilities Engineering division as part of the Spartcon brand rather than a
 * separate one.
 *
 * The artwork is used exactly as supplied — not recoloured, not distorted, not
 * cropped — so it reads correctly on any surface: its own navy ground is the
 * "clear space", by design, rather than something added in CSS.
 *
 * The source file is small (198×133) and has no transparency, which the
 * client should be aware of: if a taller hero-scale lockup or a version for a
 * light background without a navy chip is ever needed, ask for the original
 * vector artwork.
 */
import spartconLogo from "@images/brand/spartcon-logo.png";

interface Props {
  variant?: "spartcon" | "tech";
  /** "stacked" puts the mark above the subline; "inline" sets them side by side. */
  layout?: "stacked" | "inline";
  /** Kept for API compatibility — only affects the "TECHNOLOGIES" subline colour now that the mark itself is a fixed image. */
  invert?: boolean;
  /** Overall scale. Drives the mark height. */
  size?: "sm" | "md" | "lg" | "xl";
  /** Accessible name. Set to "" when a nearby element already labels it. */
  title?: string;
  class?: string;
}

const {
  variant = "spartcon",
  layout = "stacked",
  invert = false,
  size = "md",
  title,
  class: className,
} = Astro.props;

const label =
  title ?? (variant === "tech" ? "Spartcon Technologies" : "Spartcon");
---

<span
  class:list={[
    "logo",
    `logo--${layout}`,
    `logo--${size}`,
    variant === "tech" && "logo--tech",
    invert && "logo--invert",
    className,
  ]}
  role="img"
  aria-label={label}
>
  <img
    class="logo__mark"
    src={spartconLogo.src}
    width={spartconLogo.width}
    height={spartconLogo.height}
    alt=""
    loading="eager"
    decoding="async"
  />
  {variant === "tech" && <span class="logo__sub">Technologies</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    gap: 0.34em;
    align-items: center;
    line-height: 1;
    /* --logo-unit drives every internal dimension. */
    font-size: var(--logo-unit, 1.5rem);
  }

  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.18em;
  }

  .logo--inline {
    flex-direction: row;
    gap: 0.4em;
  }

  /* -------------------------------------------------------------- sizing */
  .logo--sm {
    --logo-unit: 1.125rem;
  }
  .logo--md {
    --logo-unit: 1.5rem;
  }
  .logo--lg {
    --logo-unit: 2.25rem;
  }
  .logo--xl {
    --logo-unit: 3rem;
  }

  /* The artwork is a fixed lockup on its own navy ground, so it is sized as a
     single image rather than composed from a mark + live wordmark. The ground
     IS the clear space — no extra padding is added around it.
     Native ratio 198:133 ≈ 1.49:1. */
  .logo__mark {
    height: calc(var(--logo-unit) * 1.9);
    width: auto;
    flex: none;
    transition: transform var(--d-mid) var(--e-out);
  }

  /* Inline lockups sit in tight spaces (nav bar, footer rows), so the mark is
     reduced to read as a compact badge. */
  .logo--inline .logo__mark {
    height: calc(var(--logo-unit) * 1.4);
  }

  .logo__sub {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.3em;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--teal-500);
    white-space: nowrap;
  }

  .logo--stacked .logo__sub {
    /* Optically aligns the tracked-out subline with the mark's left edge. */
    padding-left: 0.1em;
  }

  .logo--invert .logo__sub {
    color: var(--teal-400);
  }

  /* Subtle lift when the lockup is used inside a link. */
  :global(a:hover) > .logo .logo__mark {
    transform: translateY(-1px);
  }
</style>
